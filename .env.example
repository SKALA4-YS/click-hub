# Local PostgreSQL
DB_NAME=clickhub
DB_USERNAME=clickhub
DB_PASSWORD=clickhub-local
DB_POOL_MAX_SIZE=5
DATABASE_PORT=5432
DB_DATA_PATH=./db/data

# Local Compose uses demo data by default. Use demo,oauth2 only after filling Google credentials.
SPRING_PROFILES_ACTIVE=demo
CLICKHUB_JWT_SECRET=local-development-secret-change-before-production-123456
CORS_ALLOWED_ORIGINS=http://localhost:5173
CLICKHUB_OAUTH2_REDIRECT_URI=http://localhost:5173/oauth/callback

# Google OAuth2 로그인 (Google Cloud Console > APIs & Services > Credentials 에서 발급)
# 값을 채운 뒤 SPRING_PROFILES_ACTIVE=demo,oauth2 로 변경한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_PORT=5173
BACKEND_PORT=8080
