# Local PostgreSQL
DB_NAME=clickhub
DB_USERNAME=clickhub
DB_PASSWORD=clickhub-local
DB_POOL_MAX_SIZE=5
DATABASE_PORT=5432
DB_DATA_PATH=./db/data

# Google OAuth2 로그인 (Google Cloud Console > APIs & Services > Credentials 에서 발급)
# 값을 채운 뒤 backend 실행 시 SPRING_PROFILES_ACTIVE=oauth2 도 함께 켜야 한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
